# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Claude Code session-local files (launch.json, worktrees, local settings) —
# never committed. Skills ARE committed — they're shared project instructions,
# like CLAUDE.md, not session-local state.
.claude/*
!.claude/skills/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tool caches — machine-generated, hold absolute local paths (/code-review, v17.10.0)
.impeccable/

# Firebase emulator working dir (the *.log line above already covers
# firebase-debug.log / database-debug.log). There is deliberately NO
# .firebaserc in this repo — see database.rules.README.md.
.firebase/

# Claude Design sync (/design-sync) — the staged converter scripts, the bundle
# they generate, the library build they read and their machine state. All of
# it is regenerated on every sync. The COMMITTED half is everything else under
# .design-sync/: config, notes, the conventions header, docs and previews.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/.lib/
.design-sync/learnings/
.design-sync/node_modules
