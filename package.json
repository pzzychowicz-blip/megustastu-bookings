{
  "name": "megustastu-bookings",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:exec --only database --project demo-mgt-bookings \"vitest run --config vitest.rules.config.js\"",
    "rules:deploy": "firebase deploy --only database --project",
    "check:style": "node scripts/check-style-invariants.mjs",
    "test:watch": "vitest",
    "wa:backend": "node scripts/wa-backend-dev.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "overrides": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.10"
  }
}
